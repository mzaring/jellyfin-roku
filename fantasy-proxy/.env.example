# Copy to .env and fill in. Keep .env private: it holds your ESPN login cookies.

# From your league URL: https://fantasy.espn.com/football/league?leagueId=123456
LEAGUE_ID=123456

# Private leagues only (leave both blank for a public league). See README for where to find them.
ESPN_S2=
SWID=

# Optional. Normally detected automatically by matching SWID to the team owner.
# Set it if the overlay says it can't tell which team is yours.
# TEAM_ID=3

# Optional
# SEASON=2026
# PORT=8765
# CACHE_SECONDS=30
# ENABLE_RAW=1

# Try the overlay with fake data and no ESPN account
# SAMPLE=1

# Testing the score animations with SAMPLE=1: make the fake scores change every 5 seconds
# instead of every minute, and refresh the proxy's cache faster to match
# SAMPLE_STEP_SECONDS=5
# CACHE_SECONDS=5

import "pkg:/source/enums/PosterLoadStatus.bs"
import "pkg:/source/enums/TimerControl.bs"

const COLOR_NEUTRAL = "0xFFFFFFFF"
const COLOR_MUTED = "0xAAAAAAFF"
const COLOR_DIM = "0x777777FF" ' nothing scored yet
const COLOR_LEADING = "0x5CE07AFF" ' green flash for a rise in score
const COLOR_NEGATIVE = "0xFF7A7AFF"

' Score-change animation: the number pops (grows and settles) and turns green for a rise or red for
' a drop, with a small triangle beside a player's points, then returns to normal.
const POP_STEPS = 12 ' ticks of 0.04s: about half a second
const POP_SCALE = 0.35
const FLASH_TICKS = 62 ' number stays colored about 2.5 seconds
const TRI_TICKS = 100 ' triangle stays fully visible about 4 seconds...
const TRI_FADE_TICKS = 25 ' ...then fades out over 1 second
const TRI_SIZE = 12
const TRI_UP = "pkg:/images/icons/fantasyTriangleUp.png"
const TRI_DOWN = "pkg:/images/icons/fantasyTriangleDown.png"

' Layout.  One team's half is 250 wide.  If you change COLUMN_WIDTH, change the card size in
' FantasyOverlay.bs and the positions in FantasyOverlay.xml to match.
const COLUMN_WIDTH = 250
const LOGO_SIZE = 60
const LOGO_GAP = 8
const NAME_TOP = 78
const WIN_TOP = 146
const WIN_LABEL_WIDTH = 54
const WIN_BAR_HEIGHT = 8
const ROWS_TOP = 186
const ROW_HEIGHT = 48
const ROW_GAP = 2
const COLOR_ROW_BG = "0xFFFFFF1F"
const PTS_HEIGHT = 26
const PROJ_HEIGHT = 20

' Row cells: name cell 168 wide (logo + name), then a 72-wide stack with points above projected.
const NAME_WIDTH = 166
const ROW_PAD = 6
const ROW_LOGO = 28
const ROW_LOGO_GAP = 6
const NUM_WIDTH = 72

' One team's half of the fantasy overlay: logo, totals, name, win bar and one row per starter.
' The right-hand team is mirrored so both teams' points sit beside the shared slot column.
sub init()
    m.logo = m.top.findNode("logo")
    m.teamName = m.top.findNode("teamName")
    m.projTotal = m.top.findNode("projTotal")
    m.score = m.top.findNode("score")
    m.scoreGroup = m.top.findNode("scoreGroup")
    m.popTimer = m.top.findNode("popTimer")
    m.popTimer.observeField("fire", "onPopTick")
    m.winText = m.top.findNode("winText")
    m.winTrack = m.top.findNode("winTrack")
    m.winFill = m.top.findNode("winFill")
    m.rowsGroup = m.top.findNode("rows")

    setFont(m.teamName, "font:MediumBoldSystemFont", 22)
    setFont(m.projTotal, "font:SmallSystemFont", 20)
    setFont(m.score, "font:LargeBoldSystemFont", 38)
    setFont(m.winText, "font:SmallSystemFont", 20)

    m.rows = []
    m.prevPts = {}
    m.hasBaseline = false
    m.prevScore = invalid
    m.scoreBase = COLOR_NEUTRAL
    m.scoreFlashTicks = 0
    m.scorePopStep = -1
    m.logoFailed = false
    m.logoUri = ""
    m.winPercent = 0
    m.mirror = false

    m.logo.observeField("loadStatus", "onLogoLoadStatusChanged")
    applyLayout()
end sub

sub onResetFlash()
    m.hasBaseline = false
    m.prevScore = invalid
end sub

sub onMirrorChanged()
    m.mirror = m.top.mirror
    applyLayout()
    updateWinBar(m.winPercent)
    for each row in m.rows
        layoutRow(row)
    end for
end sub

' applyLayout: place the header pieces, left-aligned or mirrored
sub applyLayout()
    mirror = m.mirror
    align = mirror ? "right" : "left"
    textWidth = COLUMN_WIDTH - LOGO_SIZE - LOGO_GAP
    textLeft = mirror ? 0 : LOGO_SIZE + LOGO_GAP

    m.logo.translation = [mirror ? COLUMN_WIDTH - LOGO_SIZE : 0, 0]

    placeScore(textLeft, textWidth, align)
    place(m.projTotal, textLeft, 38, textWidth, align)
    showLogo(m.logo.visible)

    place(m.winText, mirror ? COLUMN_WIDTH - WIN_LABEL_WIDTH : 0, WIN_TOP - 8, WIN_LABEL_WIDTH, align)
    m.winTrack.width = COLUMN_WIDTH - WIN_LABEL_WIDTH - 6
    m.winTrack.translation = [mirror ? 0 : WIN_LABEL_WIDTH + 6, WIN_TOP]

    m.rowsGroup.translation = [0, ROWS_TOP]
end sub

' placeScore: the score sits in a group so it can be scaled around its own edge
sub placeScore(left as integer, width as integer, align as string)
    m.scoreGroup.translation = [left, 0]
    m.score.translation = [0, 0]
    m.score.width = width
    m.score.horizAlign = align
    m.scoreGroup.scaleRotateCenter = [(align = "right") ? width : 0, 19]
end sub

sub place(label as object, left as integer, top as integer, width as integer, align as string)
    label.translation = [left, top]
    label.width = width
    label.horizAlign = align
end sub

sub onSideChanged()
    side = m.top.side
    if type(side) <> "roAssociativeArray" then return

    m.teamName.text = toText(side.name)

    projected = toText(side.proj)
    m.projTotal.text = (projected <> "") ? "Proj " + projected : ""

    scoreText = toText(side.score)
    m.score.text = scoreText
    if Val(scoreText) = 0
        m.scoreBase = COLOR_DIM
    else
        m.scoreBase = COLOR_NEUTRAL
    end if

    scoreValue = Val(scoreText)
    if m.prevScore <> invalid
        if scoreValue <> m.prevScore
            m.scoreFlashTicks = FLASH_TICKS
            m.scorePopStep = 0
            m.score.color = (scoreValue > m.prevScore) ? COLOR_LEADING : COLOR_NEGATIVE
            m.popTimer.control = TimerControl.START
        end if
    end if
    m.prevScore = scoreValue
    if m.scoreFlashTicks <= 0 then m.score.color = m.scoreBase

    percent = Int(Val(toText(side.winPct)))
    if percent < 0 then percent = 0
    if percent > 100 then percent = 100
    updateWinBar(percent)

    updateLogo(toText(side.logo))
    updateRows(side.players)
end sub

' updateWinBar: the green fill grows from the outer edge of the card toward the center
sub updateWinBar(percent as integer)
    m.winPercent = percent
    m.winText.text = percent.toStr() + "%"

    fill = Int(m.winTrack.width * percent / 100)
    m.winFill.width = fill
    m.winFill.translation = [m.mirror ? m.winTrack.width - fill : 0, 0]
end sub

sub updateLogo(uri as string)
    if uri = ""
        showLogo(false)
        return
    end if

    ' A different address gets a fresh try.  The same address that failed is retried on the next
    ' refresh (a slow first download from the proxy shouldn't hide the logo for good).
    if m.logo.uri <> uri
        m.logoFailed = false
        m.logo.uri = uri
    else if m.logoFailed
        m.logoFailed = false
        m.logo.uri = ""
        m.logo.uri = uri
    end if

    showLogo(not m.logoFailed)
end sub

sub onLogoLoadStatusChanged()
    if m.logo.loadStatus = PosterLoadStatus.FAILED
        m.logoFailed = true
        showLogo(false)
    end if
end sub

' showLogo: With no logo, the name and totals use the freed space
sub showLogo(visible as boolean)
    m.logo.visible = visible

    used = visible ? LOGO_SIZE + LOGO_GAP : 0
    textWidth = COLUMN_WIDTH - used
    textLeft = m.mirror ? 0 : used
    align = m.mirror ? "right" : "left"

    placeScore(textLeft, textWidth, align)
    place(m.projTotal, textLeft, 38, textWidth, align)
    place(m.teamName, 0, NAME_TOP, COLUMN_WIDTH, align)
end sub

sub updateRows(players as dynamic)
    if type(players) <> "roArray" then players = []

    count = players.count()
    newPts = {}
    for i = 0 to count - 1
        player = players[i]
        row = getRow(i)

        row.group.visible = true
        row.name.text = toText(player.name)
        showRowLogo(row, toText(player.logo))
        ptsText = toText(player.pts)
        pointsValue = Val(ptsText)
        if toText(player.state) = "zero" or ptsText = "" then ptsText = "-"
        row.pts.text = ptsText
        row.proj.text = toText(player.proj)

        row.baseColor = pointsColor(toText(player.state))
        key = toText(player.name)
        newPts[key] = pointsValue

        previous = m.prevPts[key]
        if m.hasBaseline and previous <> invalid
            if pointsValue <> previous then flashRow(row, pointsValue > previous)
        end if
        if row.flashTicks <= 0 then row.pts.color = row.baseColor
    end for

    ' Hide rows left over from a longer lineup
    for i = count to m.rows.count() - 1
        m.rows[i].group.visible = false
        m.rows[i].flashTicks = 0
        m.rows[i].triTicks = 0
        m.rows[i].tri.visible = false
    end for

    m.prevPts = newPts
    if count > 0 then m.hasBaseline = true
end sub

' flashRow: pop a player's points and show a triangle: green and up for a rise, red and down for a drop
sub flashRow(row as object, rose as boolean)
    row.flashTicks = FLASH_TICKS
    row.triTicks = TRI_TICKS + TRI_FADE_TICKS
    row.popStep = 0
    row.tri.opacity = 1
    row.pts.color = rose ? COLOR_LEADING : COLOR_NEGATIVE
    row.tri.uri = rose ? TRI_UP : TRI_DOWN
    positionTriangle(row)
    row.tri.visible = true
    m.popTimer.control = TimerControl.START
end sub

' positionTriangle: just inside the points number (its width is estimated from the characters)
sub positionTriangle(row as object)
    textWidth = 0
    text = row.pts.text
    for i = 0 to Len(text) - 1
        ch = Mid(text, i + 1, 1)
        if ch = "."
            textWidth = textWidth + 7
        else if ch = "-"
            textWidth = textWidth + 8
        else
            textWidth = textWidth + 13
        end if
    end for

    top = Int((ROW_HEIGHT - PTS_HEIGHT - PROJ_HEIGHT) / 2) + Int((PTS_HEIGHT - TRI_SIZE) / 2)
    if m.mirror
        row.tri.translation = [ROW_PAD + textWidth + 4, top]
    else
        row.tri.translation = [ROW_PAD + NAME_WIDTH + NUM_WIDTH - textWidth - TRI_SIZE - 4, top]
    end if
end sub

' onPopTick: advance every running pop, and return colors to normal when a flash has run its course
sub onPopTick()
    active = false

    for each row in m.rows
        if row.triTicks > 0
            active = true
            row.triTicks = row.triTicks - 1
            if row.triTicks <= 0
                row.tri.visible = false
                row.tri.opacity = 1
            else if row.triTicks < TRI_FADE_TICKS
                row.tri.opacity = row.triTicks / TRI_FADE_TICKS
            end if
        end if

        if row.flashTicks > 0
            active = true
            row.flashTicks = row.flashTicks - 1

            if row.popStep >= 0
                row.popStep = row.popStep + 1
                if row.popStep >= POP_STEPS
                    row.popStep = -1
                    row.ptsGroup.scale = [1, 1]
                else
                    grow = 1 + POP_SCALE * Sin(3.14159 * row.popStep / POP_STEPS)
                    row.ptsGroup.scale = [grow, grow]
                end if
            end if

            if row.flashTicks <= 0
                row.pts.color = row.baseColor
                row.ptsGroup.scale = [1, 1]
            end if
        end if
    end for

    if m.scoreFlashTicks > 0
        active = true
        m.scoreFlashTicks = m.scoreFlashTicks - 1

        if m.scorePopStep >= 0
            m.scorePopStep = m.scorePopStep + 1
            if m.scorePopStep >= POP_STEPS
                m.scorePopStep = -1
                m.scoreGroup.scale = [1, 1]
            else
                grow = 1 + POP_SCALE * Sin(3.14159 * m.scorePopStep / POP_STEPS)
                m.scoreGroup.scale = [grow, grow]
            end if
        end if

        if m.scoreFlashTicks <= 0
            m.score.color = m.scoreBase
            m.scoreGroup.scale = [1, 1]
        end if
    end if

    if not active then m.popTimer.control = TimerControl.STOP
end sub

' pointsColor: dim until a player has scored, otherwise white (green and red only appear during a score-change animation)
function pointsColor(state as string) as string
    if state = "zero" then return COLOR_DIM
    return COLOR_NEUTRAL
end function

' getRow: Rows are created the first time they are needed, then reused on every refresh
function getRow(index as integer) as object
    if index < m.rows.count() then return m.rows[index]

    group = createObject("roSGNode", "Group")
    group.translation = [0, index * ROW_HEIGHT]

    nameLabel = makeLabel("font:SmallSystemFont", 22, COLOR_NEUTRAL, ROW_HEIGHT)
    projLabel = makeLabel("font:SmallSystemFont", 18, COLOR_MUTED, PROJ_HEIGHT)
    ptsLabel = makeLabel("font:SmallBoldSystemFont", 24, COLOR_NEUTRAL, PTS_HEIGHT)

    background = createObject("roSGNode", "Rectangle")
    background.translation = [0, Int(ROW_GAP / 2)]
    background.width = COLUMN_WIDTH
    background.height = ROW_HEIGHT - ROW_GAP
    background.color = COLOR_ROW_BG

    logo = createObject("roSGNode", "Poster")
    logo.width = ROW_LOGO
    logo.height = ROW_LOGO
    logo.loadDisplayMode = "scaleToFit"
    logo.visible = false

    group.appendChild(background)
    group.appendChild(logo)
    group.appendChild(nameLabel)
    group.appendChild(projLabel)
    ptsGroup = createObject("roSGNode", "Group")
    ptsGroup.appendChild(ptsLabel)
    group.appendChild(ptsGroup)

    tri = createObject("roSGNode", "Poster")
    tri.width = TRI_SIZE
    tri.height = TRI_SIZE
    tri.visible = false
    group.appendChild(tri)
    m.rowsGroup.appendChild(group)

    row = { group: group, logo: logo, name: nameLabel, proj: projLabel, pts: ptsLabel, ptsGroup: ptsGroup, tri: tri, flashTicks: 0, triTicks: 0, popStep: -1, baseColor: COLOR_NEUTRAL }
    layoutRow(row)
    m.rows.push(row)
    return row
end function

' showRowLogo: a player's NFL team logo beside the name (hidden for free agents / missing logos)
sub showRowLogo(row as object, uri as string)
    if uri = ""
        row.logo.visible = false
        return
    end if
    if row.logo.uri <> uri then row.logo.uri = uri
    row.logo.visible = true
end sub

' layoutRow: name beside a stack of points over projected; mirrored for the right-hand team
sub layoutRow(row as object)
    top = Int((ROW_HEIGHT - PTS_HEIGHT - PROJ_HEIGHT) / 2)
    logoTop = Int((ROW_HEIGHT - ROW_LOGO) / 2)
    nameWidth = NAME_WIDTH - ROW_LOGO - ROW_LOGO_GAP
    if m.mirror
        row.ptsGroup.translation = [ROW_PAD, top]
        row.pts.width = NUM_WIDTH
        row.pts.horizAlign = "left"
        row.ptsGroup.scaleRotateCenter = [0, Int(PTS_HEIGHT / 2)]
        place(row.proj, ROW_PAD, top + PTS_HEIGHT, NUM_WIDTH, "left")
        place(row.name, ROW_PAD + NUM_WIDTH, 0, nameWidth, "right")
        row.logo.translation = [COLUMN_WIDTH - ROW_PAD - ROW_LOGO, logoTop]
    else
        row.logo.translation = [ROW_PAD, logoTop]
        place(row.name, ROW_PAD + ROW_LOGO + ROW_LOGO_GAP, 0, nameWidth, "left")
        row.ptsGroup.translation = [ROW_PAD + NAME_WIDTH, top]
        row.pts.width = NUM_WIDTH
        row.pts.horizAlign = "right"
        row.ptsGroup.scaleRotateCenter = [NUM_WIDTH, Int(PTS_HEIGHT / 2)]
        place(row.proj, ROW_PAD + NAME_WIDTH, top + PTS_HEIGHT, NUM_WIDTH, "right")
    end if
end sub

function makeLabel(fontUri as string, fontSize as integer, color as string, height as integer) as object
    label = createObject("roSGNode", "Label")
    label.height = height
    label.vertAlign = "center"
    setFont(label, fontUri, fontSize)
    label.color = color
    return label
end function

sub setFont(label as object, fontUri as string, fontSize as integer)
    label.font = fontUri
    label.font.size = fontSize
end sub

' toText: Label.text must be a string, so never hand it invalid or a number
function toText(value as dynamic) as string
    if value = invalid then return ""
    if GetInterface(value, "ifString") <> invalid then return value
    return ""
end function

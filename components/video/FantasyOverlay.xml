<?xml version="1.0" encoding="utf-8"?>
<component name="FantasyOverlay" extends="Group">
  <children>
    <!-- Size is adjusted in code to fit the lineups; these are the values for nine starters -->
    <Rectangle id="card" width="580" height="516" color="0x000000E0">
      <!-- Week label, and the place status messages ("Loading...", errors) are shown -->
      <Label id="weekLabel" translation="[14,6]" width="552" height="26" vertAlign="center" horizAlign="center" color="0xAAAAAAFF" />

      <FantasyColumn id="leftColumn" translation="[14,36]" />
      <!-- Shared position column between the two lineups, like the ESPN app -->
      <Group id="slots" translation="[264,214]" />
      <FantasyColumn id="rightColumn" translation="[316,36]" mirror="true" />
    </Rectangle>

    <!-- Polls only while the overlay is visible; duration comes from the manifest -->
    <Timer id="pollTimer" repeat="true" duration="30" />
  </children>
</component>

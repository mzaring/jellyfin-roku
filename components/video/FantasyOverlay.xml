<?xml version="1.0" encoding="utf-8"?>
<component name="FantasyOverlay" extends="Group">
  <children>
    <Rectangle id="card" width="1100" height="540" color="0x000000E0">
      <!-- Week label, and the place status messages ("Loading...", errors) are shown -->
      <Label id="weekLabel" translation="[20,8]" width="1060" height="30" vertAlign="center" horizAlign="center" font="font:SmallSystemFont" color="0xAAAAAAFF" />

      <FantasyColumn id="leftColumn" translation="[20,50]" />
      <Rectangle id="divider" translation="[549,56]" width="2" height="464" color="0xFFFFFF33" />
      <FantasyColumn id="rightColumn" translation="[560,50]" />
    </Rectangle>

    <!-- Polls only while the overlay is visible; duration comes from the manifest -->
    <Timer id="pollTimer" repeat="true" duration="30" />
  </children>
</component>

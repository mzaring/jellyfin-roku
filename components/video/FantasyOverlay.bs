import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/enums/TimerControl.bs"

const COLOR_MUTED = "0xAAAAAAFF"
const COLOR_WARNING = "0xFFCC66FF"
const DEFAULT_POLL_SECONDS = 30
const MIN_POLL_SECONDS = 10

' Card geometry.  These must agree with FantasyOverlay.xml and FantasyColumn.xml:
' two 308-wide columns, a 64px slot strip between them and 14px of padding all round = 708.
const CARD_WIDTH = 708
const SLOT_WIDTH = 64
const CARD_PADDING = 14
const MESSAGE_WIDTH = 600
const MESSAGE_HEIGHT = 36
const COLUMNS_TOP = 36
const ROWS_TOP = 178
const ROW_HEIGHT = 32
const BOTTOM_PADDING = 14
const STRIP_TOP = 154

' Fantasy matchup overlay: both teams side by side, like ESPN's box score.
'
' Shown/hidden by the parent (VideoPlayerView) via the built-in `visible` field.
' While visible it polls the fantasy proxy named by `fantasy_endpoint` in the
' manifest every `fantasy_poll_seconds` seconds and renders the result.
sub init()
    m.card = m.top.findNode("card")
    m.weekLabel = m.top.findNode("weekLabel")
    m.leftColumn = m.top.findNode("leftColumn")
    m.rightColumn = m.top.findNode("rightColumn")
    m.slotStrip = m.top.findNode("slotStrip")
    m.slotsGroup = m.top.findNode("slots")
    m.slotLabels = []

    m.weekLabel.font = "font:SmallSystemFont"
    m.weekLabel.font.size = 20

    appInfo = createObject("roAppInfo")
    m.endpoint = appInfo.getValue("fantasy_endpoint")

    pollSeconds = Val(appInfo.getValue("fantasy_poll_seconds"))
    if pollSeconds < MIN_POLL_SECONDS then pollSeconds = DEFAULT_POLL_SECONDS

    m.pollTimer = m.top.findNode("pollTimer")
    m.pollTimer.duration = pollSeconds
    m.pollTimer.observeField("fire", "onPollTick")

    m.task = createObject("roSGNode", "FantasyTask")
    m.task.observeField("result", "onResult")

    m.hasData = false
    showMessageLayout()
    m.top.observeField("visible", "onVisibleChange")
end sub

' onVisibleChange: fetch immediately when shown, and only poll while shown
sub onVisibleChange()
    if m.top.visible
        if not m.hasData
            showMessageLayout()
            m.weekLabel.color = COLOR_MUTED
            m.weekLabel.text = "Loading fantasy data..."
        end if
        refresh()
        m.pollTimer.control = TimerControl.START
    else
        m.pollTimer.control = TimerControl.STOP
    end if
end sub

sub onPollTick()
    refresh()
end sub

sub refresh()
    ' Don't stack requests if the last one is still running
    if m.task.state = "run" then return

    m.task.url = m.endpoint
    m.task.control = TaskControl.RUN
end sub

sub onResult(event as object)
    result = event.getData()

    if result.ok = true
        render(result.data)
    else
        showError(toText(result.error))
    end if
end sub

sub render(data as dynamic)
    if type(data) <> "roAssociativeArray"
        showError("Unexpected data from fantasy service")
        return
    end if

    label = toText(data.label)
    stale = data.stale = true

    ' Bye week or no matchup scheduled
    if data.bye = true
        m.hasData = true
        showMessageLayout()
        m.weekLabel.color = COLOR_MUTED
        m.weekLabel.text = label + " - no matchup"
        return
    end if

    if type(data.me) <> "roAssociativeArray" or type(data.opp) <> "roAssociativeArray"
        showError("Unexpected data from fantasy service")
        return
    end if

    m.hasData = true

    lead = toText(data.lead)
    mine = data.me
    mine.leading = (lead = "me")
    theirs = data.opp
    theirs.leading = (lead = "opp")

    m.leftColumn.side = mine
    m.rightColumn.side = theirs
    updateSlots(mine.players, theirs.players)

    ' Size the card for whichever lineup is longer
    rowCount = playerCount(mine)
    if playerCount(theirs) > rowCount then rowCount = playerCount(theirs)
    showFullLayout(rowCount)

    m.weekLabel.text = stale ? label + "  (out of date)" : label
    m.weekLabel.color = stale ? COLOR_WARNING : COLOR_MUTED
end sub

' showFullLayout: the two-column card, tall enough for the longest lineup
sub showFullLayout(rowCount as integer)
    m.card.width = CARD_WIDTH
    m.card.height = COLUMNS_TOP + ROWS_TOP + rowCount * ROW_HEIGHT + BOTTOM_PADDING
    m.weekLabel.width = CARD_WIDTH - 2 * CARD_PADDING

    m.slotStrip.translation = [CARD_PADDING + 308, COLUMNS_TOP + STRIP_TOP]
    m.slotStrip.height = m.card.height - COLUMNS_TOP - STRIP_TOP - BOTTOM_PADDING
    m.slotStrip.visible = true
    m.slotsGroup.visible = true
    m.leftColumn.visible = true
    m.rightColumn.visible = true
end sub

' showMessageLayout: a slim strip for status text (loading, errors, bye week)
sub showMessageLayout()
    m.card.width = MESSAGE_WIDTH
    m.card.height = MESSAGE_HEIGHT
    m.weekLabel.width = MESSAGE_WIDTH - 2 * CARD_PADDING

    m.slotStrip.visible = false
    m.slotsGroup.visible = false
    m.leftColumn.visible = false
    m.rightColumn.visible = false
end sub

' showError: keep the last good scores on screen (marked out of date) if we have them
sub showError(message as string)
    m.weekLabel.color = COLOR_WARNING

    if m.hasData
        m.weekLabel.text = "Out of date: " + message
    else
        showMessageLayout()
        m.weekLabel.text = message
    end if
end sub

' updateSlots: position labels (QB, RB, ...) are drawn once, in the strip between the lineups
sub updateSlots(mine as dynamic, theirs as dynamic)
    m.slotsGroup.translation = [CARD_PADDING + 308, COLUMNS_TOP + ROWS_TOP]

    count = 0
    if type(mine) = "roArray" then count = mine.count()
    if type(theirs) = "roArray" and theirs.count() > count then count = theirs.count()

    for i = 0 to count - 1
        text = ""
        if type(mine) = "roArray" and i < mine.count() then text = toText(mine[i].slot)
        if text = "" and type(theirs) = "roArray" and i < theirs.count() then text = toText(theirs[i].slot)

        if i >= m.slotLabels.count()
            label = createObject("roSGNode", "Label")
            label.translation = [0, i * ROW_HEIGHT]
            label.width = SLOT_WIDTH
            label.height = ROW_HEIGHT
            label.horizAlign = "center"
            label.vertAlign = "center"
            label.font = "font:SmallBoldSystemFont"
            label.font.size = 20
            label.color = COLOR_MUTED
            m.slotsGroup.appendChild(label)
            m.slotLabels.push(label)
        end if

        m.slotLabels[i].text = text
        m.slotLabels[i].visible = true
    end for

    for i = count to m.slotLabels.count() - 1
        m.slotLabels[i].visible = false
    end for
end sub

function playerCount(side as object) as integer
    if type(side.players) <> "roArray" then return 0
    return side.players.count()
end function

' toText: Label.text must be a string, so never hand it invalid or a number
function toText(value as dynamic) as string
    if value = invalid then return ""
    if GetInterface(value, "ifString") <> invalid then return value
    return ""
end function

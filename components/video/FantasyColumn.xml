<?xml version="1.0" encoding="utf-8"?>
<component name="FantasyColumn" extends="Group">
  <interface>
    <!-- One team's data from the fantasy proxy:
         { name, score, proj, logo, leading (boolean), players: [{ slot, name, proj, pts, state }] } -->
    <field id="side" type="assocarray" alwaysNotify="true" onChange="onSideChanged" />
  </interface>

  <!-- Fonts and sizes are set in FantasyColumn.bs so every size lives in one place -->
  <children>
    <!-- Team header: logo and name (up to two lines), then projected and actual totals -->
    <Poster id="logo" translation="[0,0]" width="64" height="64" loadDisplayMode="scaleToFit" />
    <Label id="teamName" translation="[72,0]" width="296" height="72" vertAlign="center" wrap="true" numLines="2" color="0xFFFFFFFF" />
    <Label id="projTotal" translation="[0,80]" width="170" height="36" vertAlign="center" color="0xAAAAAAFF" />
    <Label id="score" translation="[170,76]" width="198" height="44" vertAlign="center" horizAlign="right" color="0xFFFFFFFF" />

    <Rectangle translation="[0,124]" width="368" height="2" color="0xFFFFFF33" />

    <!-- Column headings -->
    <Label id="headPlayer" translation="[56,130]" width="150" height="22" vertAlign="center" text="PLAYER" color="0xAAAAAAFF" />
    <Label id="headProj" translation="[242,130]" width="56" height="22" vertAlign="center" horizAlign="right" text="PROJ" color="0xAAAAAAFF" />
    <Label id="headPts" translation="[298,130]" width="70" height="22" vertAlign="center" horizAlign="right" text="PTS" color="0xAAAAAAFF" />

    <!-- Player rows are created in code, one per starter -->
    <Group id="rows" translation="[0,156]" />
  </children>
</component>
